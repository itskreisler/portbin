{
  "tool": "dotnet",
  "platform": ["win32", "linux"],
  "steps": [
    {
      "platform": ["win32"],
      "type": "download",
      "url": "https://builds.dotnet.microsoft.com/dotnet/Sdk/9.0.200/dotnet-sdk-9.0.200-win-x64.zip",
      "dest": "%TEMP%/portbin/dotnet.zip"
    },
    {
      "platform": ["win32"],
      "type": "extract",
      "archive": "%TEMP%/portbin/dotnet.zip",
      "dest": "%TEMP%/portbin/dotnet-extracted"
    },
    {
      "platform": ["win32"],
      "type": "move",
      "source": "%TEMP%/portbin/dotnet-extracted",
      "dest": "~/.local/share/portbin/tools/dotnet"
    },
    {
      "platform": ["linux"],
      "type": "download",
      "url": "https://builds.dotnet.microsoft.com/dotnet/Sdk/9.0.200/dotnet-sdk-9.0.200-linux-x64.tar.gz",
      "dest": "%TEMP%/portbin/dotnet.tar.gz"
    },
    {
      "platform": ["linux"],
      "type": "extract",
      "archive": "%TEMP%/portbin/dotnet.tar.gz",
      "dest": "%TEMP%/portbin/dotnet-extracted"
    },
    {
      "platform": ["linux"],
      "type": "move",
      "source": "%TEMP%/portbin/dotnet-extracted",
      "dest": "~/.local/share/portbin/tools/dotnet"
    },
    {
      "type": "shim",
      "name": "dotnet",
      "command": "~/.local/share/portbin/tools/dotnet/dotnet",
      "scope": "user"
    },
    {
      "type": "run",
      "command": "dotnet --version",
      "capture": true
    },
    {
      "type": "path",
      "value": "~/.local/bin",
      "scope": "user"
    }
  ]
}
