{
  "tool": "ffmpeg",
  "platform": "linux",
  "version": "release",
  "steps": [
    { "type": "download", "url": "https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz", "dest": "%TEMP%/portbin/ffmpeg.tar.xz" },
    { "type": "extract", "archive": "%TEMP%/portbin/ffmpeg.tar.xz", "dest": "~/.local/share/portbin/tools/ffmpeg" },
    { "type": "shim", "name": "ffmpeg", "command": "~/.local/share/portbin/tools/ffmpeg/bin/ffmpeg", "scope": "user" },
    { "type": "shim", "name": "ffprobe", "command": "~/.local/share/portbin/tools/ffmpeg/bin/ffprobe", "scope": "user" },
    { "type": "shim", "name": "ffplay", "command": "~/.local/share/portbin/tools/ffmpeg/bin/ffplay", "scope": "user" },
    { "type": "run", "command": "ffmpeg -version", "capture": true },
    { "type": "path", "value": "~/.local/bin", "scope": "user" }
  ]
}
