[
  {
    "path": "composer/win32.json",
    "manifest": {
      "tool": "composer",
      "platform": [
        "win32"
      ],
      "steps": [
        {
          "type": "download",
          "url": "https://getcomposer.org/download/latest-stable/composer.phar",
          "dest": "%TEMP%/portbin/composer.phar"
        },
        {
          "type": "move",
          "source": "%TEMP%/portbin/composer.phar",
          "dest": "~/.local/share/portbin/tools/composer/composer.phar"
        },
        {
          "type": "shim",
          "name": "composer",
          "command": "php ~/.local/share/portbin/tools/composer/composer.phar",
          "scope": "user"
        },
        {
          "type": "run",
          "command": "composer --version",
          "capture": true
        },
        {
          "type": "path",
          "value": "~/.local/bin",
          "scope": "user"
        }
      ]
    }
  },
  {
    "path": "ffmpeg/linux.json",
    "manifest": {
      "tool": "ffmpeg",
      "platform": "linux",
      "version": "release",
      "steps": [
        {
          "type": "download",
          "url": "https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz",
          "dest": "%TEMP%/portbin/ffmpeg.tar.xz"
        },
        {
          "type": "extract",
          "archive": "%TEMP%/portbin/ffmpeg.tar.xz",
          "dest": "~/.local/share/portbin/tools/ffmpeg"
        },
        {
          "type": "shim",
          "name": "ffmpeg",
          "command": "~/.local/share/portbin/tools/ffmpeg/bin/ffmpeg",
          "scope": "user"
        },
        {
          "type": "shim",
          "name": "ffprobe",
          "command": "~/.local/share/portbin/tools/ffmpeg/bin/ffprobe",
          "scope": "user"
        },
        {
          "type": "shim",
          "name": "ffplay",
          "command": "~/.local/share/portbin/tools/ffmpeg/bin/ffplay",
          "scope": "user"
        },
        {
          "type": "run",
          "command": "ffmpeg -version",
          "capture": true
        },
        {
          "type": "path",
          "value": "~/.local/bin",
          "scope": "user"
        }
      ]
    }
  },
  {
    "path": "ffmpeg/universal.json",
    "manifest": {
      "tool": "ffmpeg",
      "platform": "universal",
      "version": "release",
      "note": "placeholder multiplataforma: usa win32.json (Windows) o linux.json (Linux). Sin build portable unico.",
      "steps": []
    }
  },
  {
    "path": "ffmpeg/win32.json",
    "manifest": {
      "tool": "ffmpeg",
      "platform": "win32",
      "version": "release",
      "steps": [
        {
          "type": "download",
          "url": "https://www.gyan.dev/ffmpeg/builds/ffmpeg-release-essentials.zip",
          "dest": "%TEMP%/portbin/ffmpeg.zip"
        },
        {
          "type": "extract",
          "archive": "%TEMP%/portbin/ffmpeg.zip",
          "dest": "~/.local/share/portbin/tools/ffmpeg"
        },
        {
          "type": "shim",
          "name": "ffmpeg",
          "command": "~/.local/share/portbin/tools/ffmpeg/bin/ffmpeg.exe",
          "scope": "user"
        },
        {
          "type": "shim",
          "name": "ffprobe",
          "command": "~/.local/share/portbin/tools/ffmpeg/bin/ffprobe.exe",
          "scope": "user"
        },
        {
          "type": "shim",
          "name": "ffplay",
          "command": "~/.local/share/portbin/tools/ffmpeg/bin/ffplay.exe",
          "scope": "user"
        },
        {
          "type": "run",
          "command": "ffmpeg -version",
          "capture": true
        },
        {
          "type": "path",
          "value": "~/.local/bin",
          "scope": "user"
        }
      ]
    }
  },
  {
    "path": "fresh/win32.json",
    "manifest": {
      "tool": "fresh",
      "platform": "win32",
      "version": "0.4.10",
      "pbx": {
        "command": "fresh.exe"
      },
      "steps": [
        {
          "type": "download",
          "url": "https://github.com/sinelaw/fresh/releases/download/v0.4.10/fresh-editor-x86_64-pc-windows-msvc.zip",
          "dest": "%TEMP%/portbin/fresh.zip"
        },
        {
          "type": "verify",
          "file": "%TEMP%/portbin/fresh.zip",
          "sha256": "30abbfce00901b92ce55ef364af1f2d4fdf25e36f36449d3c7cb7d35573f3a8b"
        },
        {
          "type": "extract",
          "archive": "%TEMP%/portbin/fresh.zip",
          "dest": "~/.local/share/portbin/tools/fresh"
        },
        {
          "type": "shim",
          "name": "fresh",
          "command": "~/.local/share/portbin/tools/fresh/fresh.exe",
          "scope": "user"
        },
        {
          "type": "run",
          "command": "fresh --version",
          "capture": true
        },
        {
          "type": "path",
          "value": "~/.local/bin",
          "scope": "user"
        }
      ]
    }
  },
  {
    "path": "w64devkit/win32.json",
    "manifest": {
      "tool": "w64devkit",
      "platform": "win32",
      "version": "2.9.1",
      "note": "Kit de desarrollo portable (GCC 16.2, make, ninja, cmake, cpp, etc.). SFX 7zip.",
      "pbx": {
        "bin_dir": "bin"
      },
      "steps": [
        {
          "type": "download",
          "url": "https://github.com/skeeto/w64devkit/releases/download/v2.9.1/w64devkit-x64-2.9.1.7z.exe",
          "dest": "%TEMP%/portbin/w64devkit.7z.exe"
        },
        {
          "type": "verify",
          "file": "%TEMP%/portbin/w64devkit.7z.exe",
          "sha256": "9208c19755cd4964b7915b9afcf02c66d493a4c870c4b3e83f6c538d9c1237a5"
        },
        {
          "type": "extract",
          "archive": "%TEMP%/portbin/w64devkit.7z.exe",
          "dest": "~/.local/share/portbin/tools/w64devkit"
        }
      ]
    }
  }
]